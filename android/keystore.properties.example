# Copy to android/keystore.properties (gitignored) and fill in.
# Or set the environment variables named beside each key instead.
# This is the UPLOAD key. With Play App Signing, Google holds the app
# signing key; losing the upload key is recoverable through Play support.
storeFile=/absolute/path/to/flowbiz-upload.jks          # FLOWBIZ_UPLOAD_STORE_FILE
storePassword=                                          # FLOWBIZ_UPLOAD_STORE_PASSWORD
keyAlias=flowbiz-upload                                 # FLOWBIZ_UPLOAD_KEY_ALIAS
keyPassword=                                            # FLOWBIZ_UPLOAD_KEY_PASSWORD
