{
  "name": "flowbiz",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --mode demo",
    "build": "vite build && vite build --mode demo",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node --test 'src/**/*.test.js' && npm --prefix cloudflare-worker test",
    "test:rules": "firebase emulators:exec --only firestore --project flowbiz-rules-test \"node --test test/rules/*.test.mjs\"",
    "dev:emulator": "vite --mode emulator --port 5273 --strictPort",
    "emulators": "firebase emulators:start --only firestore,auth --project flowbiz-audit-test",
    "build:web": "vite build",
    "build:android": "vite build --mode android && cap sync android",
    "android:assets": "node scripts/android/generate-assets.mjs && capacitor-assets generate --android --assetPath resources --iconBackgroundColor '#286EB6' --splashBackgroundColor '#F4F6F9'",
    "android:open": "cap open android",
    "android:debug": "npm run build:android && cd android && ./gradlew assembleDebug",
    "android:bundle": "npm run build:android && cd android && ./gradlew bundleRelease",
    "android:assetlinks": "node scripts/android/assetlinks.mjs"
  },
  "dependencies": {
    "@capacitor-mlkit/barcode-scanning": "^8.2.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/network": "^8.0.1",
    "@capacitor/share": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "firebase": "^12.15.0",
    "jspdf": "^2.5.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hot-toast": "^2.4.1",
    "react-icons": "^5.7.0",
    "react-router-dom": "^6.30.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.6.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^8.1.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
