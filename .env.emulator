# Test-harness configuration for `npm run dev:emulator`.
#
# Everything here points at the LOCAL Firebase emulator suite under the
# throwaway project `flowbiz-audit-test`. No value in this file is a real
# credential and none of it reaches a production service. It exists so the
# audit/QA harness is reproducible; `.env` (real, gitignored) is untouched.
#
# The emulators are addressed on :5273 because the app is served there and
# Vite proxies the Firebase paths to :8080/:9099 same-origin.

VITE_FIREBASE_API_KEY="fake-api-key-emulator-only"
VITE_FIREBASE_AUTH_DOMAIN="localhost"
VITE_FIREBASE_PROJECT_ID="flowbiz-audit-test"
VITE_FIREBASE_STORAGE_BUCKET="flowbiz-audit-test.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="000000000000"
VITE_FIREBASE_APP_ID="1:000000000000:web:audit0harness0only"
VITE_FIREBASE_MEASUREMENT_ID=""

VITE_USE_FIREBASE_EMULATORS=true
VITE_AUTH_EMULATOR_URL=http://localhost:5273
VITE_FIRESTORE_EMULATOR_HOST=localhost
VITE_FIRESTORE_EMULATOR_PORT=5273

# Deliberately not the production worker.
VITE_FLOWBIZ_API_URL=http://localhost:5273/__no_worker__
VITE_PAYSTACK_PUBLIC_KEY=pk_test_emulator_harness_not_a_real_key
